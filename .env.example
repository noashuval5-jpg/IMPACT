# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (and Data API / API Keys).

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "publishable" key (safe for the browser; used only for login)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / "secret" key — SERVER ONLY. Never share it.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the site, without a trailing slash,
# e.g. https://shrikat-siyum.vercel.app (locally: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
